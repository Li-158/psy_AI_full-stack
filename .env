# Psychology Lab System Environment Variables
# 心理學實驗室系統環境變數

# 資料庫設定
POSTGRES_PASSWORD=your-secure-database-password-123
DATABASE_URL=postgresql://psychologylab:your-secure-database-password-123@localhost:5432/psychologylab

# JWT 設定
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long-please-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 應用程式設定
APP_NAME=Psychology Lab API
APP_VERSION=1.0.0
DEBUG=false

# 伺服器設定
HOST=0.0.0.0
PORT=3001

# 前端設定
REACT_APP_API_URL=http://localhost:3001

# CORS 設定
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# 開發工具設定
PGADMIN_DEFAULT_EMAIL=admin@psychologylab.com
PGADMIN_DEFAULT_PASSWORD=admin123
