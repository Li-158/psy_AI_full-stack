# 資料庫設定
DATABASE_URL=postgresql://psychologylab:your-secure-database-password-123@db:5432/psychologylab

# JWT 設定
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 應用程式設定
APP_NAME=Psychology Lab API
APP_VERSION=1.0.0
DEBUG=False

# 伺服器設定
HOST=0.0.0.0
PORT=3001

# CORS 設定
CORS_ORIGINS=["http://localhost:3000", "http://frontend:3000"]
